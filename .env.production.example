APP_NAME="WCC Scans Campus Directory"
APP_ENV=production
APP_KEY=                          # run: php artisan key:generate
APP_DEBUG=false
APP_URL=https://scans.blog

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=error

# ── Database ───────────────────────────────────────────────────────────
# Get these values from Hostinger hPanel → MySQL Databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u314333613_wcc_scans
DB_USERNAME=u314333613_wcc_scans
DB_PASSWORD=YOUR_DB_PASSWORD_HERE   # set this in hPanel → MySQL Databases

# ── Session ────────────────────────────────────────────────────────────
# Requires sessions table: php artisan session:table && php artisan migrate
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ── Cache ──────────────────────────────────────────────────────────────
# Use "file" on shared hosting (no Redis/Memcached typically available)
CACHE_STORE=file

# ── Queue ──────────────────────────────────────────────────────────────
# Use "sync" on shared hosting (no queue workers)
QUEUE_CONNECTION=sync

# ── Mail (optional — update if you send emails) ───────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=noreply@scans.blog
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@scans.blog
MAIL_FROM_NAME="${APP_NAME}"

# ── Filesystem ─────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
